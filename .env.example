# ==============================================================================
# SMART PLACEMENT PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Supabase Public Configuration (Accessible in Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Private Admin Configuration (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
